#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [[ "$*" == *"rails server"* ]] || [[ "$*" == *"rails s"* ]] || [[ "$*" == *"bin/rails server"* ]]; then
  echo "Preparing database..."
  ./bin/rails db:prepare || echo "Database preparation completed or not needed"
fi

exec "${@}"
