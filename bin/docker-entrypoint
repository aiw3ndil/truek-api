#!/bin/bash
set -e

echo "--- Iniciando docker-entrypoint ---"

# Limpieza opcional de tmp (recomendado para Rails en Docker)
rm -f tmp/pids/server.pid

echo "--- Ejecutando rails db:prepare ---"
./bin/rails db:prepare || echo "⚠ Falló db:prepare, pero intentando arrancar..."

echo "--- Comando final: $@ ---"
exec "$@"
