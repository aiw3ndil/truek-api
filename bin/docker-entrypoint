#!/bin/bash -e

echo "--- Entrando en docker-entrypoint ---"

# Ejecutar migraciones siempre para asegurar que la base de datos está lista
echo "Ejecutando rails db:prepare..."
if ./bin/rails db:prepare; then
  echo "✓ Base de datos preparada correctamente."
else
  echo "⚠ Advertencia: Falló db:prepare, pero intentando continuar..."
fi

echo "--- Iniciando comando: $@ ---"
exec "${@}"
